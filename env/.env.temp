# ── LLM endpoint (used for description generation and SQL generation) ────────
LLM_BASE_URL = ""
LLM_MODEL    = ""

# ── Metadata database (nl2sql_metadata) ──────────────────────────────────────
# The application user (created automatically on first docker run if missing).
METADATA_DB_HOST = ""
METADATA_DB_PORT = "5432"
METADATA_DB_USER = "nl2sql_user"
METADATA_DB_NAME = "nl2sql_metadata"
METADATA_DB_PASSWORD = ""

# ── Metadata DB superuser ────────────────────────────────────────────────────
# Used on container startup to (1) create the metadata DB + nl2sql_user role
# if they don't exist, and (2) apply migrations (e.g. CREATE EXTENSION vector,
# CREATE EXTENSION pgcrypto — both superuser-only).
METADATA_DB_ADMIN_USER = "postgres"
METADATA_DB_ADMIN_PASSWORD = ""

# ── Target-DB credential encryption ──────────────────────────────────────────
# Symmetric key used by pgcrypto to encrypt/decrypt the password column on
# registered_databases. Anyone (admin panel, manual psql) who inserts a row
# must encrypt the password with the SAME key:
#   pgp_sym_encrypt('<password>', '<DB_CRED_ENCRYPTION_KEY>')
# Use a long random value. Losing it means re-inserting every credential.
DB_CRED_ENCRYPTION_KEY=

# ── JWT authentication ────────────────────────────────────────────────────────
# HS256 secret key — must match the key used by the employer's auth system
JWT_SECRET_KEY=

# ── Query relevance filter ────────────────────────────────────────────────────
# Minimum cosine similarity between the question and any table embedding.
# Questions scoring below this threshold are rejected as off-topic.
MIN_RELEVANCE_SCORE=0.5

# ── Privilege sync toggle (target-DB-specific) ────────────────────────────────
# Set to "true" ONLY if the target DB has ERPHUB-style privileges, emp_roles,
# and role_privileges tables. Otherwise leave false and populate emp_table_access
# manually (see README).
RUN_PRIVILEGE_SYNC=false
